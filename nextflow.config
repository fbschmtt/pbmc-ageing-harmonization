nextflow.enable.dsl = 2

manifest {
    nextflowVersion = '>=25.04.0'
}

params.outdir = 'output'
params.studies = 'all'
params.test = false
params.skip_qc = false
params.merge_single_cell = false
params.merged_input = null
params.log_level = 'INFO'
params.cell_type_input = null
params.cell_type_analysis_input = null
params.cell_types = null
params.split_only = false
params.pseudobulk_input = null
params.per_type_de_dir = null
params.de_cell_type = null
params.de_test_mode = false
params.de_synthetic_test_data = false
params.allow_partial_results = false
params.project_dir = projectDir.toString()
params.python_image = 'pbmc-ageing-python:dev'
params.r_image = 'pbmc-ageing-r:dev'
params.pipeline_revision = 'unknown'
params.resume_template = null
params.analysis_only = false
params.synthetic_analysis = false
params.run_clocks = false
params.run_benchmark = false
params.top_age_gene_count = 10
params.verify_gene_profile = false
params.profile_gene = null
params.profile_cell_type = null
params.gene_profile_output = null
params.age_clock_output = null
params.aggregate_clocks_only = false
params.clock_cell_type = null
params.clock_external_studies = 'nehar_belaid26,perez22'
params.clock_methods = ''
params.clock_alphas = '0.001,0.01,0.1,1,10'
params.clock_l1_ratios = '0.1,0.5,0.9,1'
params.clock_n_jobs = 20
params.clock_calibration_samples = 10
params.clock_calibration_seed = 42
params.stub_fail_gene_report = false
params.stub_fail_clock_report = false
params.stub_fail_cell_report = false
params.stub_fail_de = false
params.stub_fail_de_report = false
params.stub_fail_all_cell_types = false
params.stub_fail_gene = false
params.stub_fail_clock = false
params.stub_fail_cell_type = false

process {
    errorStrategy = 'terminate'
}

profiles {
    standard {
        process.executor = 'local'
    }
    docker {
        docker.enabled = true
    }
    test {
        params.test = true
        params.outdir = 'output/test'
        params.de_test_mode = true
    }
    synthetic_de_test {
        params.test = true
        params.de_test_mode = false
        params.de_synthetic_test_data = true
    }
    core {
        process {
            withName: CONVERT_RDS { container = params.r_image }
            withName: HARMONIZE { container = params.python_image }
            withName: PREPARE_CELLS { container = params.python_image }
            withName: RENDER_STUDY_QC { container = params.python_image }
            withName: PSEUDOBULK { container = params.python_image }
            withName: MERGE_PSEUDOBULKS { container = params.python_image }
            withName: MERGE_SINGLE_CELLS { container = params.python_image }
            withName: RENDER_MERGE_QC { container = params.python_image }
            withName: WRITE_RUN_MANIFEST { container = params.python_image }
        }
    }
    cell_type_analysis {
        workflow.failOnIgnore = false
        process {
            withName: SPLIT_CELL_TYPES { container = params.python_image }
            withName: ANALYSE_CELL_TYPE { container = params.python_image }
            withName: RENDER_CELL_TYPE_REPORT { container = params.python_image }
            withName: WRITE_CELL_TYPE_MANIFEST { container = params.python_image }
        }
    }
    differential_expression {
        workflow.failOnIgnore = false
        process {
            withName: RUN_CELL_TYPE_PSEUDOBULK_DIFFERENTIAL_EXPRESSION {
                cpus = 1
                container = params.python_image
            }
            withName: LIST_PSEUDOBULK_CELL_TYPES { container = params.python_image }
            withName: WRITE_PSEUDOBULK_DIFFERENTIAL_EXPRESSION_MANIFEST { container = params.python_image }
            withName: RENDER_CROSS_CELL_TYPE_ANALYSIS_REPORT { container = params.python_image }
            withName: RENDER_PER_TYPE_DIFFERENTIAL_EXPRESSION_REPORTS { container = params.python_image }
            withName: ANALYSE_CELL_TYPE_DE_DIAGNOSTICS { container = params.python_image }
        }
    }
    analysis {
        workflow.failOnIgnore = false
        process {
            withName: 'COLLECT_PROFILE_DE_CONTEXT|SELECT_PROFILE_GENES|PREPARE_GENE_PROFILE_MODEL|FIT_GENE_PROFILE|RENDER_GENE_PROFILE|LIST_CLOCK_CELL_TYPES|FIT_AGE_CLOCK|RENDER_AGE_CLOCK|AGGREGATE_AGE_CLOCKS|GENERATE_SYNTHETIC_PSEUDOBULK' {
                container = params.python_image
            }
        }
    }
    integration_benchmark {
        process {
            withName: RUN_INTEGRATION_METHOD {
                container = params.python_image
                maxForks = 1
                errorStrategy = 'ignore'
            }
            withName: AGGREGATE_INTEGRATION_METHODS {
                container = params.python_image
            }
            withName: RENDER_INTEGRATION_BENCHMARK_REPORT { container = params.python_image }
        }
    }
}

// Work directories let the runner inspect declared application-level summaries
// from this invocation, including successful tasks that report partial analyses.
trace.fields = 'task_id,hash,native_id,name,status,exit,submit,duration,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar,workdir'
