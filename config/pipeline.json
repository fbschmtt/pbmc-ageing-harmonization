{
  "schema_version": 1,
  "studies_config": "config/studies.json",
  "obs_schema": "config/harmonized_obs_schema.json",
  "input_sources": "config/input_sources.json",
  "input_root": ".",
  "test_input_root": "test_data",
  "output_dir": "output/harmonized",
  "report_dir": "output/reports",
  "models": {
    "aifi_l1": "aifi_models/ref_pbmc_clean_celltypist_model_AIFI_L1_2024-04-18.pkl",
    "aifi_l2": "aifi_models/ref_pbmc_clean_celltypist_model_AIFI_L2_2024-04-19.pkl",
    "aifi_l3": "aifi_models/ref_pbmc_clean_celltypist_model_AIFI_L3_2024-04-19.pkl"
  },
  "processing": {
    "target_sum": 10000,
    "hvg": {"min_mean": 0.0125, "max_mean": 3.0, "min_disp": 0.5},
    "exclude_vdj_regex": "^(?:TRA[VDJ]|TRB[VDJ]|IGL[VDJ]|IGH[VDJ])",
    "neighbors": {"n_neighbors": 50, "n_pcs": 30},
    "random_seed": 42,
    "output_compression": "gzip"
  },
  "merge": {
    "pseudobulk": {
      "groupby": ["sample", "aifi_l2_majority"]
    },
    "single_cell": {
      "enabled": false,
      "gene_join": "inner",
      "annotation_level": "l2",
      "integration": {
        "method": "harmony",
        "batch_key": "study",
        "adjusted_basis": "X_pca_harmony"
      }
    }
  },
  "cell_type_analysis": {
    "analysis_version": 4,
    "split_by": "aifi_l2_majority",
    "min_cells": 50,
    "min_fraction_denominator_cells": 10,
    "clustering": {
      "method": "leiden",
      "resolution": 0.5
    },
    "integration": {
      "method": "harmony",
      "batch_key": "study",
      "adjusted_basis": "X_pca_harmony"
    },
    "fraction_model": {
      "binomial_bootstrap_replicates": 1000,
      "binomial_bootstrap_seed": 0
    },
    "l2_parent_l1": {
      "ASDC": "DC",
      "CD14 monocyte": "Monocyte",
      "CD16 monocyte": "Monocyte",
      "CD56bright NK cell": "NK cell",
      "CD56dim NK cell": "NK cell",
      "CD8aa": "T cell",
      "DN T cell": "T cell",
      "Effector B cell": "B cell",
      "Erythrocyte": "Erythrocyte",
      "ILC": "ILC",
      "Intermediate monocyte": "Monocyte",
      "MAIT": "T cell",
      "Memory B cell": "B cell",
      "Memory CD4 T cell": "T cell",
      "Memory CD8 T cell": "T cell",
      "Naive B cell": "B cell",
      "Naive CD4 T cell": "T cell",
      "Naive CD8 T cell": "T cell",
      "Plasma cell": "B cell",
      "Platelet": "Platelet",
      "Progenitor cell": "Progenitor cell",
      "Proliferating NK cell": "NK cell",
      "Proliferating T cell": "T cell",
      "Transitional B cell": "B cell",
      "Treg": "T cell",
      "cDC1": "DC",
      "cDC2": "DC",
      "gdT": "T cell",
      "pDC": "DC"
    },
    "l2_parent_l1_provenance": "inferred manually from AIFI L2 label semantics and checked against the shipped AIFI L1/L2 reference-model label vocabularies; validate against the AIFI atlas paper and reference-model taxonomy before inferential use"
  },
  "differential_expression": {
    "method": "pydeseq2",
    "split_by": "aifi_l2_majority",
    "per_study_design": "~ age + sex",
    "merged_design": "~ study + age + sex",
    "age_term": "age",
    "optional_covariates": ["bmi", "cmv"],
    "alpha": 0.05,
    "sample_inclusion": {
      "minimum_age_years_inclusive": 20,
      "minimum_cells_per_pseudobulk_inclusive": 10
    }
  }
}
