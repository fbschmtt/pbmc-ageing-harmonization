{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PBMC ageing study registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "studies"],
  "properties": {
    "schema_version": {"const": 1},
    "studies": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/study"}
    }
  },
  "$defs": {
    "study": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "test_input", "counts_source", "preparation", "annotation", "provenance"],
      "properties": {
        "input": {"type": "string", "minLength": 1},
        "test_input": {"type": "string", "minLength": 1},
        "counts_source": {"type": "string", "pattern": "^(X|raw|layer:.+)$"},
        "features": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source_column": {"type": "string", "minLength": 1},
            "duplicate_policy": {"enum": ["error", "sum"]},
            "split": {
              "type": "object",
              "additionalProperties": false,
              "required": ["separator", "index"],
              "properties": {
                "separator": {"type": "string"},
                "index": {"type": "integer", "minimum": 0}
              }
            }
          }
        },
        "preparation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["adapter", "dependencies"],
          "properties": {
            "adapter": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
            "dependencies": {
              "type": "array",
              "items": {"type": "string", "minLength": 1},
              "uniqueItems": true
            },
            "allow_cell_subset": {"type": "boolean"}
          }
        },
        "annotation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method"],
          "properties": {
            "method": {"enum": ["existing", "celltypist"]},
            "levels": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"enum": ["l1", "l2", "l3"]}
            }
          },
          "allOf": [
            {
              "if": {"properties": {"method": {"const": "celltypist"}}},
              "then": {"required": ["levels"]}
            }
          ]
        },
        "conversion": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "test_source", "output", "format", "assay"],
          "properties": {
            "source": {"type": "string", "minLength": 1},
            "test_source": {"type": "string", "minLength": 1},
            "output": {"type": "string", "minLength": 1},
            "format": {"type": "string", "minLength": 1},
            "assay": {"type": "string", "minLength": 1}
          }
        },
        "provenance": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
